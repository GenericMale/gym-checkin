<!DOCTYPE html>
<html lang="<%= locale %>">
  <head>
    <%- include('partials/head', { title: `${branding.shortName} - ${__('course.title')}` }) %>
    <style>
      .calendar-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .grid-row {
        display: grid;
        gap: 10px;
      }
      @media (max-width: 1280px) {
        .grid-row { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
      }
      @media (max-width: 768px) {
        .grid-row { grid-template-columns: 1fr !important; }
      }
      .day-col {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
      }
      .day-head {
        background: #f3f4f6;
        padding: 6px 12px;
        font-weight: 700;
        font-size: 0.8rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #f1f5f9;
      }
      .day-count {
        font-size: 0.7rem;
        color: #6b7280;
        font-weight: 600;
      }
      .course-row {
        display: grid;
        grid-template-columns: 75px 34px 1fr auto auto;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.78rem;
        cursor: pointer;
        transition: background 0.1s;
      }
      .course-row:nth-child(even) { background: #fafafa; }
      .course-row:hover { background: #f8fafc; }
      .time {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-weight: 600;
        color: #334155;
        font-size: 0.72rem;
        white-space: nowrap;
      }
      .num {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--color-primary, #2563eb);
        background: #eff6ff;
        padding: 1px 4px;
        border-radius: 4px;
        text-align: center;
        min-width: 22px;
        white-space: nowrap;
      }
      .name {
        font-weight: 600;
        color: #0f172a;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .trainer {
        font-size: 0.7rem;
        color: #64748b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 90px;
      }
      .hall-badge {
        font-size: 0.66rem;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 4px;
        white-space: nowrap;
      }
      .calendar-footer {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 16px;
        border-top: 1px solid #f1f5f9;
        margin-top: 12px;
        padding-top: 12px;
        font-size: 0.72rem;
        color: #6b7280;
        align-items: center;
      }
      .calendar-footer strong { color: #0f172a; }
      .legend-item { display: flex; align-items: center; gap: 4px; }
    </style>
  </head>
  <body class="bg-[#f8fafa] text-gray-800 font-sans min-h-screen">
    <!-- Navigation -->
    <%- include('partials/nav') %>

    <main class="container mx-auto p-6 space-y-6">
      <!-- Page Header -->
      <section
        class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
      >
        <div>
          <h2 class="font-brand-serif text-2xl flex items-center gap-3 text-gray-800">
            <span class="w-1.5 h-6 bg-primary rounded-full"></span>
            <%= __('course.title') %>
          </h2>
          <p class="text-xs text-gray-400 mt-1"><%= __('course.subtitle') %></p>
        </div>
        <button
          onclick="openModal('addTurnplanModal')"
          class="bg-primary hover:bg-primary-hover text-white px-4 py-2.5 rounded-2xl transition shadow-md font-bold text-xs uppercase tracking-wider flex items-center gap-2 cursor-pointer shrink-0"
        >
          <span>+</span>
          <%= __('course.add') %>
        </button>
      </section>

      <!-- Grace Period Settings Section -->
      <section class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6">
        <form
          method="POST"
          action="<%= url('/admin/update-settings') %>"
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-4"
        >
          <div>
            <h3 class="font-bold text-gray-800 text-sm"><%= __('course.gracePeriod') %></h3>
            <p class="text-xs text-gray-400 mt-0.5"><%= __('course.gracePeriodDesc') %></p>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <input
              type="number"
              name="grace_period_minutes"
              value="<%= settings.grace_period_minutes || 30 %>"
              class="w-24 bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-bold text-center outline-none focus:ring-2 ring-primary transition text-gray-800"
              required
            />
            <button
              type="submit"
              class="bg-gray-800 hover:bg-black text-white font-bold px-4 py-2.5 rounded-xl text-xs uppercase tracking-wider transition cursor-pointer"
            >
              <%= __('common.save') %>
            </button>
          </div>
        </form>
      </section>

      <!-- Calendar Section -->
      <section class="bg-white rounded-3xl shadow-sm border border-gray-100 p-4 md:p-6">
        <%
          const normalizedTurnplan = turnplan.map(item => {
            let days = [];
            try { days = JSON.parse(item.weekdays); } catch(_e) { days = item.weekdays ? item.weekdays.split(',') : []; }
            return { ...item, days };
          });
          const hasDay = (day) => normalizedTurnplan.some(item => item.days.includes(day));
          const rows = [
            ['Mo', 'Di', 'Mi'].filter(hasDay),
            ['Do', 'Fr', 'Sa', 'So'].filter(hasDay),
          ];
          const hallColors = {};
          halls.forEach((h, i) => {
            hallColors[h.id] = halls.length > 0 ? Math.round((i * 360) / halls.length) : 0;
          });
        %>
        <% if (turnplan.length === 0) { %>
        <div class="text-center text-gray-400 py-12 text-sm italic">
          <%= __('course.noCourses') %>
        </div>
        <% } else { %>
        <div class="calendar-grid">
          <% rows.forEach(row => { if (row.length === 0) return; %>
          <div class="grid-row" style="grid-template-columns: repeat(<%= row.length %>, minmax(0, 1fr));">
            <% row.forEach(day => {
              const dayCourses = normalizedTurnplan.filter(item => item.days.includes(day));
            %>
            <div class="day-col">
              <div class="day-head">
                <span><%= __('weekdays.' + day) %></span>
                <span class="day-count"><%= dayCourses.length %> <%= __('course.countLabel') %></span>
              </div>
              <div class="course-list">
                <% dayCourses.forEach(item => { %>
                <div
                  class="course-row edit-turnplan-card"
                  data-id="<%= item.id %>"
                  data-name="<%= item.name %>"
                  data-hall="<%= item.hall_id %>"
                  data-trainers="<%= JSON.stringify(turnplanTrainerMap[item.id] || []) %>"
                  data-number="<%= item.course_number || '' %>"
                  data-weekdays="<%= JSON.stringify(item.days) %>"
                  data-from="<%= item.time_from %>"
                  data-to="<%= item.time_to %>"
                >
                  <span class="time"><%= item.time_from %>–<%= item.time_to %></span>
                  <span class="num"><%= item.course_number ? item.course_number : '' %></span>
                  <span class="name" title="<%= item.name %>"><%= item.name %></span>
                  <span class="trainer" title="<%= item.trainer_names || '' %>"
                    ><%= item.trainer_names || '' %></span
                  >
                  <span
                    class="hall-badge"
                    style="background: hsl(<%= hallColors[item.hall_id] %> 65% 90%); color: hsl(<%= hallColors[item.hall_id] %> 55% 32%)"
                    ><%= item.hall_short %></span
                  >
                </div>
                <% }) %>
              </div>
            </div>
            <% }) %>
          </div>
          <% }) %>
        </div>

        <!-- Hall Legend -->
        <footer class="calendar-footer">
          <strong><%= __('common.halls') %>:</strong>
          <% halls.forEach(h => { %>
          <span class="legend-item">
          <span
            class="hall-badge"
            style="background: hsl(<%= hallColors[h.id] %> 65% 90%); color: hsl(<%= hallColors[h.id] %> 55% 32%)"
            ><%= h.short_name || h.name %></span
          >
            <%= h.name %>
          </span>
          <% }) %>
        </footer>
        <% } %>
      </section>
    </main>

    <!-- Add Turnplan Modal -->
    <div id="addTurnplanModal" class="modal-overlay hidden">
      <div
        class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden border border-gray-100"
      >
        <div class="p-6 border-b border-gray-100 flex justify-between items-center">
          <h2 class="font-brand-serif text-xl text-gray-800"><%= __('course.add') %></h2>
          <button
            onclick="closeModal('addTurnplanModal')"
            class="text-gray-400 hover:text-gray-600 cursor-pointer"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              ></path>
            </svg>
          </button>
        </div>
        <form action="<%= url('/admin/add-turnplan') %>" method="POST" class="p-6 space-y-4">
          <div>
            <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
              ><%= __('course.name') %></label
            >
            <input
              type="text"
              name="name"
              placeholder="<%= __('course.namePlaceholder') %>"
              class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition"
              required
            />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
                ><%= __('course.number') %></label
              >
              <input
                type="text"
                name="course_number"
                maxlength="8"
                placeholder="<%= __('course.numberPlaceholder') %>"
                class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
                ><%= __('common.hall') %></label
              >
              <select
                name="hall_id"
                class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition cursor-pointer"
                required
              >
                <% halls.forEach(h => { %>
                <option value="<%= h.id %>"
                  ><%= h.short_name ? h.short_name + ' – ' : '' %><%= h.name %></option
                >
                <% }) %>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
              ><%= __('course.allowedTrainers') %></label
            >
            <div
              class="grid grid-cols-2 gap-2 bg-gray-50 p-3 rounded-xl border border-gray-200 text-xs font-medium max-h-40 overflow-y-auto"
            >
              <% trainers.forEach(t => { %>
              <label class="flex items-center gap-1.5 cursor-pointer text-gray-700">
                <input
                  type="checkbox"
                  name="trainer_ids"
                  value="<%= t.id %>"
                  class="text-primary rounded cursor-pointer"
                />
                <%= t.name %>
              </label>
              <% }) %>
            </div>
            <p class="text-[10px] text-gray-400 mt-1.5"><%= __('course.allowedTrainersHint') %></p>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
              ><%= __('common.weekday') %></label
            >
            <div
              class="grid grid-cols-4 gap-2 bg-gray-50 p-3 rounded-xl border border-gray-200 text-xs font-medium"
            >
              <% const days = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So']; %>
              <% days.forEach(day => { %>
              <label class="flex items-center gap-1.5 cursor-pointer text-gray-700">
                <input
                  type="radio"
                  name="weekdays"
                  value="<%= day %>"
                  required
                  class="text-primary cursor-pointer"
                />
                <%= day %>
              </label>
              <% }) %>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
                ><%= __('common.timeFrom') %></label
              >
              <input
                type="time"
                name="time_from"
                required
                value="08:30"
                class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
                ><%= __('common.timeTo') %></label
              >
              <input
                type="time"
                name="time_to"
                required
                value="09:15"
                class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition"
              />
            </div>
          </div>
          <button
            type="submit"
            class="w-full bg-primary hover:bg-primary-hover text-white font-bold py-3 rounded-xl shadow-lg transition mt-2 cursor-pointer text-sm"
          >
            <%= __('common.add') %>
          </button>
        </form>
      </div>
    </div>

    <!-- Edit Turnplan Modal -->
    <div id="editTurnplanModal" class="modal-overlay hidden">
      <div
        class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden border border-gray-100"
      >
        <div class="p-6 border-b border-gray-100 flex justify-between items-center">
          <h2 class="font-brand-serif text-xl text-gray-800"><%= __('course.edit') %></h2>
          <button
            onclick="closeModal('editTurnplanModal')"
            class="text-gray-400 hover:text-gray-600 cursor-pointer"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              ></path>
            </svg>
          </button>
        </div>
        <form id="editTurnplanForm" method="POST" class="p-6 space-y-4">
          <div>
            <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
              ><%= __('course.name') %></label
            >
            <input
              type="text"
              name="name"
              id="editTurnplanName"
              class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition"
              required
            />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
                ><%= __('course.number') %></label
              >
              <input
                type="text"
                name="course_number"
                id="editTurnplanNumber"
                maxlength="8"
                class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
                ><%= __('common.hall') %></label
              >
              <select
                name="hall_id"
                id="editTurnplanHall"
                class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition cursor-pointer"
                required
              >
                <% halls.forEach(h => { %>
                <option value="<%= h.id %>"
                  ><%= h.short_name ? h.short_name + ' – ' : '' %><%= h.name %></option
                >
                <% }) %>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
              ><%= __('course.allowedTrainers') %></label
            >
            <div
              class="grid grid-cols-2 gap-2 bg-gray-50 p-3 rounded-xl border border-gray-200 text-xs font-medium max-h-40 overflow-y-auto"
            >
              <% trainers.forEach(t => { %>
              <label class="flex items-center gap-1.5 cursor-pointer text-gray-700">
                <input
                  type="checkbox"
                  name="trainer_ids"
                  value="<%= t.id %>"
                  class="text-primary rounded turnplan-trainer-cb cursor-pointer"
                />
                <%= t.name %>
              </label>
              <% }) %>
            </div>
            <p class="text-[10px] text-gray-400 mt-1.5"><%= __('course.allowedTrainersHint') %></p>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
              ><%= __('common.weekday') %></label
            >
            <div
              class="grid grid-cols-4 gap-2 bg-gray-50 p-3 rounded-xl border border-gray-200 text-xs font-medium"
            >
              <% const daysList = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So']; %>
              <% daysList.forEach(day => { %>
              <label class="flex items-center gap-1.5 cursor-pointer text-gray-700">
                <input
                  type="radio"
                  name="weekdays"
                  value="<%= day %>"
                  required
                  class="text-primary turnplan-day-radio cursor-pointer"
                />
                <%= day %>
              </label>
              <% }) %>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
                ><%= __('common.timeFrom') %></label
              >
              <input
                type="time"
                name="time_from"
                id="editTurnplanTimeFrom"
                required
                class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"
                ><%= __('common.timeTo') %></label
              >
              <input
                type="time"
                name="time_to"
                id="editTurnplanTimeTo"
                required
                class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition"
              />
            </div>
          </div>
          <div class="flex gap-2 mt-2">
            <button
              type="submit"
              class="flex-1 bg-primary hover:bg-primary-hover text-white font-bold py-3 rounded-xl shadow-lg transition cursor-pointer text-sm"
            >
              <%= __('common.save') %>
            </button>
            <button
              type="button"
              id="deleteTurnplanBtn"
              class="bg-red-50 hover:bg-red-100 text-red-600 px-6 py-3 rounded-xl font-bold transition cursor-pointer text-sm"
            >
              <%= __('common.delete') %>
            </button>
          </div>
        </form>
        <form id="deleteTurnplanForm" method="POST" class="hidden"></form>
      </div>
    </div>

    <script>
      function openModal(id) {
          document.getElementById(id).classList.remove('hidden');
      }

      function closeModal(id) {
          document.getElementById(id).classList.add('hidden');
      }

      document.querySelectorAll('.modal-overlay').forEach(modal => {
          modal.addEventListener('click', (e) => {
              if (e.target === modal) closeModal(modal.id);
          });
      });

      document.querySelectorAll('.edit-turnplan-card').forEach(card => {
          card.addEventListener('click', () => {
              const btn = card.querySelector('.edit-turnplan-btn') || card;
              const id = btn.getAttribute('data-id');
              const name = btn.getAttribute('data-name');
              const hallId = btn.getAttribute('data-hall');
              const trainerIdsJson = btn.getAttribute('data-trainers');
              const number = btn.getAttribute('data-number');
              const weekdaysJson = btn.getAttribute('data-weekdays');
              const timeFrom = btn.getAttribute('data-from');
              const timeTo = btn.getAttribute('data-to');

              document.getElementById('editTurnplanName').value = name;
              document.getElementById('editTurnplanHall').value = hallId;
              document.getElementById('editTurnplanNumber').value = number || '';
              document.getElementById('editTurnplanTimeFrom').value = timeFrom;
              document.getElementById('editTurnplanTimeTo').value = timeTo;

              document.getElementById('editTurnplanForm').action = `<%= url('/admin/edit-turnplan/') %>${id}`;
              document.getElementById('deleteTurnplanForm').action = `<%= url('/admin/delete-turnplan/') %>${id}`;

              let days = [];
              try { days = JSON.parse(weekdaysJson); } catch(_e) { days = []; }
              document.querySelectorAll('.turnplan-day-radio').forEach(cb => {
                  cb.checked = days.includes(cb.value);
              });

              let trainerIds = [];
              try { trainerIds = JSON.parse(trainerIdsJson); } catch(_e) { trainerIds = []; }
              document.querySelectorAll('.turnplan-trainer-cb').forEach(cb => {
                  cb.checked = trainerIds.includes(parseInt(cb.value, 10));
              });

              document.getElementById('deleteTurnplanBtn').onclick = () => {
                  if (confirm('<%= __('common.deleteConfirm') %>')) {
                      document.getElementById('deleteTurnplanForm').submit();
                  }
              };
              openModal('editTurnplanModal');
          });
      });
    </script>
  </body>
</html>
