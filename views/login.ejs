<!DOCTYPE html>
<html lang="<%= locale %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= branding.shortName %> - <%= __('login.title') %></title>
    <link rel="stylesheet" href="<%= url('/static/style.css') %>" />
    <style>
      :root {
        --color-primary: <%= branding.colors.primary %>;
        --color-primary-hover: <%= branding.colors.primaryHover %>;
      }
    </style>
  </head>
  <body class="bg-[#f8fafa] h-screen flex items-center justify-center relative font-sans">
    <div class="absolute top-0 left-0 w-full h-1/3 bg-primary rounded-b-[3rem] shadow-sm z-0"></div>

    <div class="bg-white p-8 rounded-3xl shadow-xl w-96 relative z-10 border border-gray-100 space-y-6">
      <div class="text-center">
        <h2 class="font-brand-serif text-2xl tracking-tight text-gray-800">
          <%= branding.name %> <span class="text-primary"><%= branding.accentText %></span>
        </h2>
      </div>

      <% if (locals.error) { %>
      <p
        class="bg-red-50 text-red-600 p-3 rounded-xl text-center text-xs font-bold border border-red-100"
      >
        <%= error %>
      </p>
      <% } %>

      <form method="POST" action="<%= url('/admin/login') %>" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('login.passwordPlaceholder') %></label>
          <input
            type="password"
            name="password"
            placeholder="••••••••"
            class="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-sm font-medium text-gray-800 outline-none focus:ring-2 ring-primary transition"
            required
          />
        </div>
        <button
          class="w-full bg-primary hover:bg-primary-hover text-white font-bold p-3.5 rounded-xl transition shadow-md cursor-pointer text-xs uppercase tracking-wider"
        >
          <%= __('login.btn') %>
        </button>
      </form>
    </div>
  </body>
</html>
