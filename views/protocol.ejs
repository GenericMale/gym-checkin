<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
    <%- include('partials/head', { title: `${branding.shortName} - ${__('ADMIN_TAB_PROTOCOL')}` }) %>
</head>
<body class="bg-[#f8fafa] text-gray-800 font-sans min-h-screen">

    <!-- Navigation -->
    <%- include('partials/nav') %>

    <main class="container mx-auto p-6 space-y-6">
        <!-- Page Header & Main Actions -->
        <section class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h2 class="font-brand-serif text-2xl flex items-center gap-3 text-gray-800">
                    <span class="w-1.5 h-6 bg-primary rounded-full"></span>
                    <%= __('ADMIN_PROTOCOL_TITLE') %>
                </h2>
                <p class="text-xs text-gray-400 mt-1"><%= __('ADMIN_PROTOCOL_SUBTITLE') %></p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <button onclick="openModal('addCheckinModal')" class="bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 px-4 py-2.5 rounded-2xl text-xs font-bold transition flex items-center gap-2 cursor-pointer shadow-sm">
                    <span>+</span> <%= __('ADMIN_ADD_CHECKIN') %>
                </button>
                <% if (logs.length > 0) { %>
                    <button id="deleteAllShown" class="bg-red-50 hover:bg-red-100 text-red-600 px-4 py-2.5 rounded-2xl text-xs font-bold transition flex items-center gap-2 cursor-pointer">
                        <%= __('ADMIN_DELETE_ALL_SHOWN') %>
                    </button>
                <% } %>
                <a href="<%= url('/admin/export?month=' + filters.month + (filters.trainer ? '&trainer=' + filters.trainer : '') + (filters.hall ? '&hall=' + filters.hall : '')) %>" class="bg-primary hover:bg-primary-hover text-white px-4 py-2.5 rounded-2xl text-xs font-bold uppercase tracking-wider shadow-md transition flex items-center gap-2 cursor-pointer">
                    <%= __('ADMIN_EXCEL_EXPORT') %>
                </a>
            </div>
        </section>

        <!-- Filter Bar -->
        <section class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6">
            <form id="filterForm" method="GET" action="<%= url('/admin/protocol') %>" class="grid grid-cols-1 md:grid-cols-5 gap-4 items-end">
                <%
                    const [fYear, fMonth] = filters.month.split('-');
                    const currentYear = new Date().getFullYear();
                    const monthKeys = ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'];
                %>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_YEAR') %></label>
                    <select id="selectYear" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition cursor-pointer">
                        <% for(let y = currentYear; y >= currentYear - 5; y--) { %>
                            <option value="<%= y %>" <%= fYear == y ? 'selected' : '' %>><%= y %></option>
                        <% } %>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_MONTH') %></label>
                    <select id="selectMonth" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition cursor-pointer">
                        <% monthKeys.forEach((key) => { %>
                            <option value="<%= key %>" <%= fMonth == key ? 'selected' : '' %>><%= __('MONTHS.' + key) %></option>
                        <% } ) %>
                    </select>
                </div>
                <input type="hidden" name="month" id="hiddenMonth" value="<%= filters.month %>">

                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_TRAINER_FILTER') %></label>
                    <select name="trainer" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition cursor-pointer">
                        <option value=""><%= __('ADMIN_ALL') %></option>
                        <% trainers.forEach(t => { %>
                            <option value="<%= t.id %>" <%= filters.trainer == t.id ? 'selected' : '' %>><%= t.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_HALL_FILTER') %></label>
                    <select name="hall" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition cursor-pointer">
                        <option value=""><%= __('ADMIN_ALL') %></option>
                        <% halls.forEach(h => { %>
                            <option value="<%= h.id %>" <%= filters.hall == h.id ? 'selected' : '' %>><%= h.name %></option>
                        <% }) %>
                    </select>
                </div>
                <button type="submit" class="bg-gray-800 hover:bg-black text-white font-bold py-2.5 rounded-xl text-sm shadow-md transition cursor-pointer"><%= __('ADMIN_FILTER_BTN') %></button>
            </form>
        </section>

        <%
            let totalMins = 0;
            let totalPay = 0;
            logs.forEach(log => {
                totalMins += (log.duration_minutes || 0);
                totalPay += (log.totalPay || 0);
            });
        %>

        <!-- Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
                <p class="text-xs font-bold text-gray-400 uppercase mb-1"><%= __('ADMIN_UNITS') %></p>
                <p class="text-3xl font-brand-serif text-gray-800"><%= logs.length %></p>
            </div>
            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
                <p class="text-xs font-bold text-gray-400 uppercase mb-1"><%= __('ADMIN_TOTAL_TIME') %></p>
                <p class="text-3xl font-brand-serif text-gray-800"><%= Math.floor(totalMins / 60) %>h <%= totalMins % 60 %>m</p>
            </div>
            <div class="p-6 rounded-3xl border border-primary/20 shadow-sm bg-primary/5">
                <p class="text-xs font-bold text-primary uppercase mb-1"><%= __('ADMIN_TOTAL_COMPENSATION') %></p>
                <p class="text-3xl font-brand-serif text-primary"><%= totalPay.toFixed(2) %> €</p>
            </div>
        </div>

        <!-- Table -->
        <section class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-gray-50 text-gray-400 uppercase text-[9px] tracking-widest font-bold">
                        <tr>
                            <th class="px-6 py-4"><%= __('ADMIN_TABLE_TRAINER_HALL') %></th>
                            <th class="px-6 py-4"><%= __('ADMIN_TABLE_TRAINERS') %></th>
                            <th class="px-6 py-4"><%= __('ADMIN_TABLE_DATE_TIME') %></th>
                            <th class="px-6 py-4"><%= __('ADMIN_TABLE_DURATION') %></th>
                            <th class="px-6 py-4 text-right"><%= __('ADMIN_TABLE_MAIN_COMP') %></th>
                            <th class="px-6 py-4 text-right"><%= __('ADMIN_TABLE_HELPER_COMP') %></th>
                            <th class="px-6 py-4"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        <% logs.forEach(log => {
                            const helperNames = log.helpers.map(h => h.name).join(', ');
                            const helperIds = JSON.stringify(log.helpers.map(h => h.trainer_id));
                            const dateVal = log.date || (log.start_timestamp ? log.start_timestamp.split(' ')[0] : '');
                        %>
                            <tr class="hover:bg-gray-50 transition group cursor-pointer edit-checkin-row"
                                data-id="<%= log.id %>"
                                data-main="<%= log.main_trainer_id %>"
                                data-hall="<%= log.hall_id %>"
                                data-helpers='<%= helperIds %>'
                                data-date="<%= dateVal %>"
                                data-start="<%= log.start_time %>"
                                data-end="<%= log.end_time %>">
                                <td class="px-6 py-4">
                                    <div class="font-bold text-gray-800"><%= log.course_name %></div>
                                    <div class="text-[10px] text-primary uppercase font-bold"><%= log.hall_name %></div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="font-bold text-gray-700 text-xs"><%= __('ADMIN_MAIN_SHORT') %>: <%= log.main_trainer_name %></div>
                                    <% if (helperNames) { %>
                                        <div class="text-[10px] text-gray-500 italic"><%= __('ADMIN_HELPER_SHORT') %>: <%= helperNames %></div>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-gray-800 text-xs font-medium">
                                        <%= dateVal %>
                                    </div>
                                    <div class="text-[10px] text-gray-400 font-mono">
                                        <%= log.start_time %> - <%= log.end_time %>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2.5 py-1 bg-primary/10 text-primary rounded-full text-[10px] font-bold">
                                        <%= log.duration_minutes %> Min.
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right font-mono font-bold text-primary">
                                    <%= (log.mainPay || 0).toFixed(2) %> €
                                </td>
                                <td class="px-6 py-4 text-right font-mono font-bold text-gray-500">
                                    <%= (log.helperPay || 0).toFixed(2) %> €
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <button class="text-gray-400 hover:text-primary transition p-2 rounded-lg hover:bg-gray-100 cursor-pointer">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                        <% if (logs.length === 0) { %>
                            <tr><td colspan="8" class="px-6 py-20 text-center text-gray-300 italic"><%= __('ADMIN_TABLE_NO_ENTRIES') %></td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <!-- Add Checkin Modal -->
    <div id="addCheckinModal" class="modal-overlay hidden">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md overflow-hidden border border-gray-100">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center">
                <h2 class="font-brand-serif text-xl text-gray-800"><%= __('ADMIN_ADD_CHECKIN') %></h2>
                <button onclick="closeModal('addCheckinModal')" class="text-gray-400 hover:text-gray-600 cursor-pointer">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <form action="<%= url('/admin/add-checkin') %>" method="POST" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_MAIN_TRAINER') %></label>
                    <select name="main_trainer_id" required class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition cursor-pointer">
                        <% mainTrainers.forEach(t => { %>
                            <option value="<%= t.id %>"><%= t.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_HELPER_TRAINERS') %></label>
                    <div class="grid grid-cols-2 gap-2 bg-gray-50 p-3 rounded-xl border border-gray-200 text-xs font-medium max-h-32 overflow-y-auto">
                        <% helperTrainers.forEach(t => { %>
                            <label class="flex items-center gap-1.5 cursor-pointer text-gray-700">
                                <input type="checkbox" name="helper_ids" value="<%= t.id %>" class="text-primary rounded cursor-pointer"> <%= t.name %>
                            </label>
                        <% }) %>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_HALL_FILTER') %></label>
                    <select name="hall_id" required class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition cursor-pointer">
                        <% halls.forEach(h => { %>
                            <option value="<%= h.id %>"><%= h.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_DATE') %></label>
                    <input type="date" name="date" required value="<%= new Date().toISOString().split('T')[0] %>" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_START_TIME') %></label>
                        <input type="time" name="start_time" required value="08:30" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_END_TIME') %></label>
                        <input type="time" name="end_time" required value="09:15" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition">
                    </div>
                </div>
                <button type="submit" class="w-full bg-primary hover:bg-primary-hover text-white font-bold py-3 rounded-xl shadow-lg transition mt-2 cursor-pointer text-sm">
                    <%= __('ADMIN_ADD_CHECKIN_SUBMIT') %>
                </button>
            </form>
        </div>
    </div>

    <!-- Edit Checkin Modal -->
    <div id="editCheckinModal" class="modal-overlay hidden">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md overflow-hidden border border-gray-100">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center">
                <h2 class="font-brand-serif text-xl text-gray-800"><%= __('ADMIN_EDIT_CHECKIN') %></h2>
                <button onclick="closeModal('editCheckinModal')" class="text-gray-400 hover:text-gray-600 cursor-pointer">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <form id="editCheckinForm" method="POST" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_MAIN_TRAINER') %></label>
                    <select name="main_trainer_id" id="editCheckinMainTrainer" required class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition cursor-pointer">
                        <% mainTrainers.forEach(t => { %>
                            <option value="<%= t.id %>"><%= t.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_HELPER_TRAINERS') %></label>
                    <div class="grid grid-cols-2 gap-2 bg-gray-50 p-3 rounded-xl border border-gray-200 text-xs font-medium max-h-32 overflow-y-auto">
                        <% helperTrainers.forEach(t => { %>
                            <label class="flex items-center gap-1.5 cursor-pointer text-gray-700">
                                <input type="checkbox" name="helper_ids" value="<%= t.id %>" class="text-primary rounded edit-helper-cb cursor-pointer"> <%= t.name %></label>
                        <% }) %>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_HALL_FILTER') %></label>
                    <select name="hall_id" id="editCheckinHall" required class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition cursor-pointer">
                        <% halls.forEach(h => { %>
                            <option value="<%= h.id %>"><%= h.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_DATE') %></label>
                    <input type="date" name="date" id="editCheckinDate" required class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_START_TIME') %></label>
                        <input type="time" name="start_time" id="editCheckinStart" required class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_END_TIME') %></label>
                        <input type="time" name="end_time" id="editCheckinEnd" required class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition">
                    </div>
                </div>
                <div class="flex gap-2 mt-2">
                    <button type="submit" class="flex-1 bg-primary hover:bg-primary-hover text-white font-bold py-3 rounded-xl shadow-lg transition cursor-pointer text-sm">
                        <%= __('ADMIN_SAVE') %>
                    </button>
                    <button type="button" id="deleteCheckinBtn" class="bg-red-50 hover:bg-red-100 text-red-600 px-6 py-3 rounded-xl font-bold transition cursor-pointer text-sm">
                        <%= __('ADMIN_DELETE') %>
                    </button>
                </div>
            </form>
            <form id="deleteCheckinForm" method="POST" class="hidden"></form>
        </div>
    </div>

    <script>
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        document.querySelectorAll('.modal-overlay').forEach(modal => {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal(modal.id);
            });
        });

        document.querySelectorAll('.edit-checkin-row').forEach(row => {
            row.addEventListener('click', () => {
                const id = row.getAttribute('data-id');
                const mainTrainerId = row.getAttribute('data-main');
                const hallId = row.getAttribute('data-hall');
                const helperIdsJson = row.getAttribute('data-helpers');
                const date = row.getAttribute('data-date');
                const start = row.getAttribute('data-start');
                const end = row.getAttribute('data-end');

                document.getElementById('editCheckinMainTrainer').value = mainTrainerId;
                document.getElementById('editCheckinHall').value = hallId;
                document.getElementById('editCheckinDate').value = date;
                document.getElementById('editCheckinStart').value = start;
                document.getElementById('editCheckinEnd').value = end || '';
                document.getElementById('editCheckinForm').action = `<%= url('/admin/edit-checkin/') %>${id}`;

                let helperIds = [];
                try { helperIds = JSON.parse(helperIdsJson); } catch(_e) { helperIds = []; }
                document.querySelectorAll('.edit-helper-cb').forEach(cb => {
                    cb.checked = helperIds.includes(parseInt(cb.value));
                });

                document.getElementById('deleteCheckinBtn').onclick = async () => {
                    if (confirm('<%= __('ADMIN_DELETE_CONFIRM') %>')) {
                        const response = await fetch(`<%= url('/admin/delete-checkin/') %>${id}`, { method: 'POST' });
                        if (response.ok) {
                            location.reload();
                        }
                    }
                };
                openModal('editCheckinModal');
            });
        });

        document.getElementById('filterForm').addEventListener('submit', function() {
            const year = document.getElementById('selectYear').value;
            const month = document.getElementById('selectMonth').value;
            document.getElementById('hiddenMonth').value = `${year}-${month}`;
        });

        const deleteAllBtn = document.getElementById('deleteAllShown');
        if (deleteAllBtn) {
            deleteAllBtn.addEventListener('click', async function() {
                if (confirm('<%= __('ADMIN_DELETE_ALL_CONFIRM') %>')) {
                    const params = new URLSearchParams(window.location.search);
                    const month = params.get('month') || '<%= filters.month %>';
                    const trainer = params.get('trainer') || '';
                    const hall = params.get('hall') || '';

                    const response = await fetch(`<%= url('/admin/delete-filtered-checkins') %>`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ month, trainer, hall })
                    });
                    if (response.ok) {
                        location.reload();
                    }
                }
            });
        }
    </script>
</body>
</html>
