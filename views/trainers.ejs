<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
    <%- include('partials/head', { title: `${branding.shortName} - ${__('ADMIN_TAB_TRAINERS')}` }) %>
</head>
<body class="bg-[#f8fafa] text-gray-800 font-sans min-h-screen">

    <!-- Navigation -->
    <%- include('partials/nav') %>

    <main class="container mx-auto p-6 space-y-6">
        <!-- Page Header -->
        <section class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h2 class="font-brand-serif text-2xl flex items-center gap-3 text-gray-800">
                    <span class="w-1.5 h-6 bg-primary rounded-full"></span>
                    <%= __('ADMIN_TRAINERS') %>
                </h2>
                <p class="text-xs text-gray-400 mt-1"><%= __('ADMIN_TRAINERS_SUBTITLE') %></p>
            </div>
            <button onclick="openModal('addTrainerModal')" class="bg-primary hover:bg-primary-hover text-white px-4 py-2.5 rounded-2xl transition shadow-md font-bold text-xs uppercase tracking-wider flex items-center gap-2 cursor-pointer shrink-0">
                <span>+</span> <%= __('ADMIN_ADD_TRAINER') %>
            </button>
        </section>

        <!-- Trainers List -->
        <section class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <% trainers.forEach(trainer => { %>
                    <div class="bg-gray-50 hover:bg-white rounded-2xl p-4 border border-gray-100 hover:border-gray-200 transition flex items-center justify-between gap-4 group shadow-2xs">
                        <div class="space-y-1">
                            <h3 class="font-bold text-gray-800 text-base"><%= trainer.name %></h3>
                            <div class="text-xs text-gray-500 font-medium space-y-1">
                                <p class="font-mono text-gray-400">PIN: <%= trainer.pin %></p>
                                <p class="text-gray-700 font-semibold pt-0.5">
                                    <span><%= __('ADMIN_MAIN_SHORT') %>: <strong class="text-primary font-mono"><%= (trainer.main_wage_first_hour || 0).toFixed(2) %> €</strong> / <strong class="text-primary font-mono"><%= (trainer.main_wage_additional || 0).toFixed(2) %> €</strong></span>
                                    <span class="text-gray-300 mx-1.5">•</span>
                                    <span><%= __('ADMIN_HELPER_SHORT') %>: <strong class="text-gray-800 font-mono"><%= (trainer.helper_wage || 0).toFixed(2) %> €</strong></span>
                                </p>
                            </div>
                        </div>
                        <button onclick="openEditTrainerModal('<%= trainer.id %>', '<%= trainer.name %>', '<%= trainer.pin %>', '<%= trainer.main_wage_first_hour || 0 %>', '<%= trainer.main_wage_additional || 0 %>', '<%= trainer.helper_wage || 0 %>')" class="text-gray-400 hover:text-primary transition p-2 rounded-lg hover:bg-gray-100 cursor-pointer shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                        </button>
                    </div>
                <% }) %>
                <% if (trainers.length === 0) { %>
                    <div class="col-span-full text-center text-gray-400 py-12 text-sm italic"><%= __('ADMIN_NO_TRAINERS') %></div>
                <% } %>
            </div>
        </section>
    </main>

    <!-- Add Trainer Modal -->
    <div id="addTrainerModal" class="modal-overlay hidden">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md overflow-hidden border border-gray-100">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center">
                <h2 class="font-brand-serif text-xl text-gray-800"><%= __('ADMIN_ADD_TRAINER') %></h2>
                <button onclick="closeModal('addTrainerModal')" class="text-gray-400 hover:text-gray-600 cursor-pointer">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <form action="<%= url('/admin/add-trainer') %>" method="POST" class="p-6 space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_NAME') %></label>
                        <input type="text" name="name" placeholder="<%= __('ADMIN_NAME') %>" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition" required>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_PIN') %></label>
                        <input type="text" name="pin" placeholder="<%= __('ADMIN_PIN') %>" pattern="[0-9]{4}" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition" required>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_MAIN_WAGE_FIRST_HOUR') %></label>
                    <input type="number" step="0.01" name="main_wage_first_hour" placeholder="25.00" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition" required>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_MAIN_WAGE_ADDITIONAL') %></label>
                    <input type="number" step="0.01" name="main_wage_additional" placeholder="20.00" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition" required>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_HELPER_WAGE') %></label>
                    <input type="number" step="0.01" name="helper_wage" placeholder="10.00" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition" required>
                </div>
                <button type="submit" class="w-full bg-primary hover:bg-primary-hover text-white font-bold py-3 rounded-xl shadow-lg transition mt-2 cursor-pointer text-sm">
                    <%= __('ADMIN_ADD') %>
                </button>
            </form>
        </div>
    </div>

    <!-- Edit Trainer Modal -->
    <div id="editTrainerModal" class="modal-overlay hidden">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md overflow-hidden border border-gray-100">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center">
                <h2 class="font-brand-serif text-xl text-gray-800"><%= __('ADMIN_EDIT_TRAINER') %></h2>
                <button onclick="closeModal('editTrainerModal')" class="text-gray-400 hover:text-gray-600 cursor-pointer">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <form id="editTrainerForm" method="POST" class="p-6 space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_NAME') %></label>
                        <input type="text" name="name" id="editTrainerName" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition" required>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_PIN') %></label>
                        <input type="text" name="pin" id="editTrainerPin" pattern="[0-9]{4}" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition" required>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_MAIN_WAGE_FIRST_HOUR') %></label>
                    <input type="number" step="0.01" name="main_wage_first_hour" id="editTrainerMainWageFirst" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition" required>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_MAIN_WAGE_ADDITIONAL') %></label>
                    <input type="number" step="0.01" name="main_wage_additional" id="editTrainerMainWageAdditional" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition" required>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1.5"><%= __('ADMIN_HELPER_WAGE') %></label>
                    <input type="number" step="0.01" name="helper_wage" id="editTrainerHelperWage" class="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-sm font-medium outline-none focus:ring-2 ring-primary transition" required>
                </div>
                <div class="flex gap-2 mt-2">
                    <button type="submit" class="flex-1 bg-primary hover:bg-primary-hover text-white font-bold py-3 rounded-xl shadow-lg transition cursor-pointer text-sm">
                        <%= __('ADMIN_SAVE') %>
                    </button>
                    <button type="button" id="deleteTrainerBtn" class="bg-red-50 hover:bg-red-100 text-red-600 px-6 py-3 rounded-xl font-bold transition cursor-pointer text-sm">
                        <%= __('ADMIN_DELETE') %>
                    </button>
                </div>
            </form>
            <form id="deleteTrainerForm" method="POST" class="hidden"></form>
        </div>
    </div>

    <script>
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        document.querySelectorAll('.modal-overlay').forEach(modal => {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal(modal.id);
            });
        });

        function openEditTrainerModal(id, name, pin, mainWageFirst, mainWageAdditional, helperWage) {
            document.getElementById('editTrainerName').value = name;
            document.getElementById('editTrainerPin').value = pin;
            document.getElementById('editTrainerMainWageFirst').value = mainWageFirst;
            document.getElementById('editTrainerMainWageAdditional').value = mainWageAdditional;
            document.getElementById('editTrainerHelperWage').value = helperWage;
            document.getElementById('editTrainerForm').action = `<%= url('/admin/edit-trainer/') %>${id}`;
            document.getElementById('deleteTrainerForm').action = `<%= url('/admin/delete-trainer/') %>${id}`;

            document.getElementById('deleteTrainerBtn').onclick = () => {
                if (confirm('<%= __('ADMIN_DELETE_CONFIRM') %>')) {
                    document.getElementById('deleteTrainerForm').submit();
                }
            };
            openModal('editTrainerModal');
        }
    </script>
</body>
</html>
